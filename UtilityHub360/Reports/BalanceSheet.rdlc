<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BalanceSheetDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>00000000-0000-0000-0000-000000000000</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="BalanceSheetData">
      <Query>
        <DataSourceName>BalanceSheetDataSource</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="ItemType">
          <DataField>ItemType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AccountName">
          <DataField>AccountName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AccountType">
          <DataField>AccountType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Amount">
          <DataField>Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ReferenceId">
          <DataField>ReferenceId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="SummaryData">
      <Query>
        <DataSourceName>BalanceSheetDataSource</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="AsOfDate">
          <DataField>AsOfDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TotalCurrentAssets">
          <DataField>TotalCurrentAssets</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalFixedAssets">
          <DataField>TotalFixedAssets</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalOtherAssets">
          <DataField>TotalOtherAssets</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalAssets">
          <DataField>TotalAssets</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalCurrentLiabilities">
          <DataField>TotalCurrentLiabilities</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalLongTermLiabilities">
          <DataField>TotalLongTermLiabilities</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalLiabilities">
          <DataField>TotalLiabilities</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalEquity">
          <DataField>TotalEquity</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="IsBalanced">
          <DataField>IsBalanced</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <!-- Header -->
          <Textbox Name="ReportTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>BALANCE SHEET - DETAILED</Value>
                    <Style>
                      <FontSize>18pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#1976d2</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>ReportTitle</rd:DefaultName>
            <Top>0.25in</Top>
            <Left>0in</Left>
            <Height>0.4in</Height>
            <Width>7.5in</Width>
            <ZIndex>10</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>
          
          <!-- As of Date -->
          <Textbox Name="AsOfDate">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Format(First(Fields!AsOfDate.Value, "SummaryData"), "MMMM dd, yyyy")</Value>
                    <Style>
                      <FontSize>11pt</FontSize>
                      <Color>#666666</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>AsOfDate</rd:DefaultName>
            <Top>0.7in</Top>
            <Left>0in</Left>
            <Height>0.3in</Height>
            <Width>7.5in</Width>
            <ZIndex>9</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>

          <!-- ASSETS SECTION HEADER -->
          <Textbox Name="AssetsHeader">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>ASSETS</Value>
                    <Style>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>#2e7d32</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Left</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>AssetsHeader</rd:DefaultName>
            <Top>1.1in</Top>
            <Left>0.25in</Left>
            <Height>0.35in</Height>
            <Width>7in</Width>
            <ZIndex>8</ZIndex>
            <Style>
              <Border>
                <Color>#2e7d32</Color>
                <Style>Solid</Style>
                <Width>2pt</Width>
              </Border>
              <BackgroundColor>#e8f5e9</BackgroundColor>
              <PaddingLeft>5pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>2pt</PaddingTop>
              <PaddingBottom>2pt</PaddingBottom>
            </Style>
          </Textbox>

          <!-- Detailed Assets Table with Categories -->
          <Tablix Name="DetailedAssetsTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
                  <Width>5in</Width>
                </TablixColumn>
                <TablixColumn>
                  <Width>2in</Width>
                </TablixColumn>
              </TablixColumns>
              <TablixRows>
                <!-- Category Header Row -->
                <TablixRow>
                  <Height>0.3in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CategoryHeader">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Category.Value</Value>
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#424242</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CategoryHeader</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#e0e0e0</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#fafafa</BackgroundColor>
                            <PaddingLeft>8pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>4pt</PaddingTop>
                            <PaddingBottom>4pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CategoryHeaderAmount">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value />
                                  <Style>
                                    <FontSize>10pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CategoryHeaderAmount</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#e0e0e0</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#fafafa</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>8pt</PaddingRight>
                            <PaddingTop>4pt</PaddingTop>
                            <PaddingBottom>4pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Detail Row -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="AccountName">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!AccountName.Value</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <Color>#616161</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>AccountName</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>25pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="AccountAmount">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!Amount.Value, "C2")</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <Color>#616161</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>AccountAmount</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>8pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Category Subtotal Row -->
                <TablixRow>
                  <Height>0.28in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CategorySubtotalLabel">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="Total " &amp; Fields!Category.Value</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#424242</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CategorySubtotalLabel</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#bdbdbd</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#f5f5f5</BackgroundColor>
                            <PaddingLeft>15pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>3pt</PaddingTop>
                            <PaddingBottom>3pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CategorySubtotalAmount">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Sum(Fields!Amount.Value), "C2")</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#424242</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CategorySubtotalAmount</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>#bdbdbd</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#f5f5f5</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>8pt</PaddingRight>
                            <PaddingTop>3pt</PaddingTop>
                            <PaddingBottom>3pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="Category">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Category.Value</GroupExpression>
                    </GroupExpressions>
                    <Filters>
                      <Filter>
                        <FilterExpression>=Fields!ItemType.Value</FilterExpression>
                        <Operator>Equal</Operator>
                        <FilterValues>
                          <FilterValue>CURRENT_ASSET</FilterValue>
                        </FilterValues>
                      </Filter>
                    </Filters>
                  </Group>
                  <TablixMembers>
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                    </TablixMember>
                    <TablixMember>
                      <Group Name="Details">
                        <GroupExpressions>
                          <GroupExpression>=Fields!ReferenceId.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <TablixMembers>
                        <TablixMember />
                      </TablixMembers>
                    </TablixMember>
                    <TablixMember>
                      <KeepWithGroup>Before</KeepWithGroup>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <DataSetName>BalanceSheetData</DataSetName>
            <Top>1.5in</Top>
            <Left>0.25in</Left>
            <Height>0.83in</Height>
            <Width>7in</Width>
            <ZIndex>7</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Tablix>

          <!-- Total Current Assets -->
          <Rectangle Name="TotalCurrentAssets">
            <ReportItems>
              <Textbox Name="TotalCurrentAssetsLabel">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>TOTAL CURRENT ASSETS</Value>
                        <Style>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#2e7d32</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Left</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>TotalCurrentAssetsLabel</rd:DefaultName>
                <Top>0in</Top>
                <Left>0in</Left>
                <Height>0.3in</Height>
                <Width>5in</Width>
                <ZIndex>1</ZIndex>
                <Style>
                  <Border>
                    <Color>#757575</Color>
                    <Style>Solid</Style>
                    <Width>1pt</Width>
                  </Border>
                  <BackgroundColor>#e8f5e9</BackgroundColor>
                  <PaddingLeft>8pt</PaddingLeft>
                  <PaddingRight>2pt</PaddingRight>
                  <PaddingTop>4pt</PaddingTop>
                  <PaddingBottom>4pt</PaddingBottom>
                </Style>
              </Textbox>
              <Textbox Name="TotalCurrentAssetsValue">
                <CanGrow>true</CanGrow>
                <KeepTogether>true</KeepTogether>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>=Format(First(Fields!TotalCurrentAssets.Value, "SummaryData"), "C2")</Value>
                        <Style>
                          <FontSize>10pt</FontSize>
                          <FontWeight>Bold</FontWeight>
                          <Color>#2e7d32</Color>
                        </Style>
                      </TextRun>
                    </TextRuns>
                    <Style>
                      <TextAlign>Right</TextAlign>
                    </Style>
                  </Paragraph>
                </Paragraphs>
                <rd:DefaultName>TotalCurrentAssetsValue</rd:DefaultName>
                <Top>0in</Top>
                <Left>5in</Left>
                <Height>0.3in</Height>
                <Width>2in</Width>
                <Style>
                  <Border>
                    <Color>#757575</Color>
                    <Style>Solid</Style>
                    <Width>1pt</Width>
                  </Border>
                  <BackgroundColor>#e8f5e9</BackgroundColor>
                  <PaddingLeft>2pt</PaddingLeft>
                  <PaddingRight>8pt</PaddingRight>
                  <PaddingTop>4pt</PaddingTop>
                  <PaddingBottom>4pt</PaddingBottom>
                </Style>
              </Textbox>
            </ReportItems>
            <KeepTogether>true</KeepTogether>
            <Top>2.4in</Top>
            <Left>0.25in</Left>
            <Height>0.3in</Height>
            <Width>7in</Width>
            <ZIndex>6</ZIndex>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Rectangle>

          <!-- Fixed Assets Section (Similar structure) -->
          <Tablix Name="FixedAssetsTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn>
