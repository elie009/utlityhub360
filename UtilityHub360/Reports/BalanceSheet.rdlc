                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#424242</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#e0e0e0</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>#fafafa</BackgroundColor>
                            <PaddingLeft>8pt</PaddingLeft>
                            <PaddingTop>4pt</PaddingTop>
