              <PaddingBottom>5pt</PaddingBottom>
            </Style>
          </Textbox>

          <!-- Balance Check -->
          <Textbox Name="BalanceCheck">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=IIF(First(Fields!IsBalanced.Value, "SummaryData") = 1, "✓ Balance Sheet is BALANCED", "⚠ Balance Sheet is NOT balanced")</Value>
                    <Style>
                      <FontSize>10pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <Color>=IIF(First(Fields!IsBalanced.Value, "SummaryData") = 1, "#2e7d32", "#d32f2f")</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>BalanceCheck</rd:DefaultName>
            <Top>5.9in</Top>
            <Left>0.25in</Left>
            <Height>0.3in</Height>
            <Width>7in</Width>
            <Style>
              <Border>
                <Color>LightGrey</Color>
                <Style>Solid</Style>
              </Border>
              <BackgroundColor>#fafafa</BackgroundColor>
              <PaddingLeft>2pt</PaddingLeft>
              <PaddingRight>2pt</PaddingRight>
              <PaddingTop>5pt</PaddingTop>
              <PaddingBottom>5pt</PaddingBottom>
            </Style>
          </Textbox>

        </ReportItems>
        <Height>6.5in</Height>
        <Style />
      </Body>
      <Width>7.5in</Width>
      <Page>
